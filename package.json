{
  "name": "hl",
  "version": "1.0.0",
  "description": "A mobile client for Hyperliquid — perps, spot, vaults and prediction markets. Expo + React Native.",
  "license": "MIT",
  "keywords": [
    "hyperliquid",
    "perps",
    "dex",
    "trading",
    "expo",
    "react-native",
    "defi"
  ],
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest.e2e.config.js",
    "smoke": "bun run scripts/smoke-testnet.ts",
    "smoke:sign": "bun run scripts/smoke-signing.ts",
    "smoke:account": "bun run scripts/smoke-account.ts",
    "smoke:transfers": "bun run scripts/smoke-transfers.ts",
    "smoke:withdraw": "bun run scripts/smoke-withdraw.ts",
    "smoke:vaults": "bun run scripts/smoke-vaults.ts",
    "probe:vault-signer": "bun run scripts/probe-vault-signer.ts",
    "doctor": "npx react-doctor@latest",
    "icons:generate": "bun run scripts/generate-token-icons.ts",
    "postinstall": "npx install-skia"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.1",
