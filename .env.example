# Hyperliquid client configuration.
#
# IMPORTANT: every value here is inlined into the shipped JS bundle by Expo
# (that is what the EXPO_PUBLIC_ prefix means). Public configuration only —
# never put a private key, API secret, or agent credential in this file.
# Agent private keys live in the device Keychain (see src/hyperliquid/auth).

# Which Hyperliquid network to talk to: "mainnet" | "testnet".
# Testnet keeps development free of real funds — keep it as the default until
# the client explicitly ships to mainnet.
EXPO_PUBLIC_HL_ENV=testnet

# Builder address that receives builder fees on every order, and the fee itself
# in TENTHS OF A BASIS POINT. `buildBuilderFee` sends this value as the per-order
# `f`, so the number below is what every order actually pays -- it is not a
# ceiling with a smaller charge underneath it.
#
# 10 = 1 basis point = 0.01%. Chosen against the live-measured base rates:
#   perp taker 0.045%   -> all-in 0.055%, a 22% uplift
#   perp maker 0.015%   -> the builder fee is already 67% of the exchange's own
#   spot taker 0.07%, spot maker 0.04%
# The protocol ceiling is 100 for perp (0.1%) and 1000 for spot (1%). At 50 --
# the previous placeholder -- a maker order would pay 3.3x more to the builder
# than to Hyperliquid, which is why it is not that.
#
# One value covers perp and spot, taker and maker alike; the wire has no way to
# vary it per market type. Requires the user to approve the builder once, which
# is NOT yet implemented.
# Leave EXPO_PUBLIC_HL_BUILDER_ADDRESS empty to disable builder fees entirely.
EXPO_PUBLIC_HL_BUILDER_ADDRESS=
EXPO_PUBLIC_HL_MAX_BUILDER_FEE=10

# Referral code applied to new accounts. Leave empty to skip referral setup.
EXPO_PUBLIC_HL_REFERRAL_CODE=

# Testnet-only signer for smoke/e2e scripts. NOT EXPO_PUBLIC_ — never inline a
# private key into the bundle (config/envGuards.test.ts enforces this).
# Disposable key, no funds. To use it on the device, paste it into the
# diagnostic screen's import field — never alias it under EXPO_PUBLIC_.
HL_TESTNET_SIGNER_KEY=

# Sentry project this build reports crashes to. Safe to publish — a DSN is a
# write-only ingest endpoint, not a credential, and it ships inside the bundle
# either way (EXPO_PUBLIC_ is inlined at build time).
#
# LEAVE IT EMPTY and Sentry is simply disabled: init runs with no transport,
# every call is a no-op, and the Hyperliquid module has no remote log sink.
# That is the right default for a contributor, and for a fork it avoids
# reporting into somebody else's project.
EXPO_PUBLIC_SENTRY_DSN=

# Uploads source maps at BUILD time. This one IS a credential — never give it
# the EXPO_PUBLIC_ prefix, and never commit it.
SENTRY_AUTH_TOKEN=


# ---------------------------------------------------------------------------
# Script and end-to-end gates. None of these are app configuration — the app
# never reads them — and all four are OFF unless set, which is why they are
# commented out rather than left empty.
# ---------------------------------------------------------------------------

# Runs the end-to-end suite against LIVE testnet. Without it every e2e file
# skips itself. `bun run test` is unaffected either way.
#   HL_E2E=1 bun run test:e2e --testPathPattern session
# HL_E2E=1

# Which account `bun run smoke:account` reads. Read-only, and it falls back to
# a known testnet address with open positions when unset — set it to see your
# own.
# HL_SMOKE_ADDRESS=0x...

# DANGER: the two below make a signing script actually SEND. Both default to a
# dry run that builds and signs the action and then stops, which is the useful
# mode; setting either to 1 moves real testnet balances with no confirmation
# step. Read the script's header before you do.
# HL_WITHDRAW_EXECUTE=1     # withdrawals.e2e.ts performs the withdrawal
# HL_VAULT_PROBE_EXECUTE=1  # probe-vault-signer.ts executes the probe
